# Spider / Playwright
GLOBAL_SPIDER_EL_WAIT_TIME=10

# 猎聘备注浏览器配置
# 可选值：chrome / edge；留空表示按代码默认顺序自动尝试
LIEPIN_NOTE_BROWSER=chrome

# 建议使用独立的 Playwright 自动化目录，并手动登录一次后复用
# 不建议直接指向默认的 Chrome/Edge User Data 根目录
LIEPIN_NOTE_USER_DATA_DIR=

# 浏览器 profile 名称，例如 Default、Profile 1
LIEPIN_NOTE_PROFILE_DIRECTORY=Default
